# ==========================================
# RESEND EMAIL CONFIGURATION
# ==========================================

# Resend API Key (Get this from your Resend dashboard)
RESEND_API_KEY=re_xxxxxxxxxxxxxxx

# Sender info for the notification email sent to the Admin
RESEND_FROM_ADMIN=INTELLEON Website <info@djdevil.online>

# Sender info for the auto-reply "Thank you" email sent to clients
RESEND_FROM_USER=INTELLEON <info@djdevil.online>

# Admin email address where contact form submissions will be received
ADMIN_EMAIL=<complete with your admin email address>

# Email logo URL for the "Thank you" email template
EMAIL_LOGO_URL= <complete with your email logo URL, e.g., https://intelleon.com/assets/img/img_logo_intelleon.png>